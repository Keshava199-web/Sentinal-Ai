generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  createdAt          DateTime           @default(now())
  role               Role               @default(VIEWER)
  updatedAt          DateTime           @updatedAt
  alertsAssigned     Alert[]            @relation("AssignedAlerts")
  auditLogs          AuditLog[]         @relation("UserAuditLogs")
  iocs               IOC[]              @relation("CreatedIOCs")
  assignedIncidents  Incident[]         @relation("AssignedIncidents")
  reportedIncidents  Incident[]         @relation("ReportedIncidents")
  comments           IncidentComment[]
  evidence           IncidentEvidence[]
  linkedIncidentIOCs IncidentIOC[]      @relation("LinkedIncidentIOCs")
  timelineEntries    IncidentTimeline[]
}

model Incident {
  id              String             @id @default(uuid())
  title           String
  description     String
  sourceIp        String?
  createdAt       DateTime           @default(now())
  assignedToId    String?
  category        IncidentCategory   @default(OTHER)
  destinationIp   String?
  detectionSource DetectionSource    @default(MANUAL)
  hostname        String?
  reporterId      String
  resolvedAt      DateTime?
  updatedAt       DateTime           @updatedAt
  status          IncidentStatus     @default(OPEN)
  severity        AlertSeverity
  alerts          Alert[]
  auditLogs       AuditLog[]         @relation("IncidentAuditLogs")
  assignedTo      User?              @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  reporter        User               @relation("ReportedIncidents", fields: [reporterId], references: [id])
  comments        IncidentComment[]
  evidence        IncidentEvidence[]
  iocs            IncidentIOC[]
  timeline        IncidentTimeline[]

  @@index([resolvedAt])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([detectionSource])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, severity])
  @@index([status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  incidentId String?
  createdAt  DateTime    @default(now())
  action     AuditAction
  incident   Incident?   @relation("IncidentAuditLogs", fields: [incidentId], references: [id])
  user       User        @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([incidentId])
}

model IncidentTimeline {
  id          String         @id @default(uuid())
  incidentId  String
  userId      String?
  action      TimelineAction
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([createdAt])
  @@index([action])
  @@index([incidentId, createdAt])
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String
  userId     String
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([userId])
  @@index([createdAt])
  @@index([incidentId, createdAt])
}

model IncidentEvidence {
  id           String   @id @default(uuid())
  incidentId   String
  uploadedById String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storagePath  String
  sha256       String
  uploadedAt   DateTime @default(now())
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@index([uploadedById])
  @@index([uploadedAt])
  @@index([sha256])
}

model IOC {
  id          String        @id @default(uuid())
  type        IOCType
  value       String
  description String?
  severity    IOCSeverity
  confidence  Int           @default(50)
  firstSeen   DateTime?
  lastSeen    DateTime?
  status      IOCStatus     @default(ACTIVE)
  source      IOCSource     @default(MANUAL)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdBy   User          @relation("CreatedIOCs", fields: [createdById], references: [id])
  incidents   IncidentIOC[]

  @@unique([type, value, source])
  @@index([firstSeen])
  @@index([lastSeen])
  @@index([type])
  @@index([value])
  @@index([type, value])
  @@index([severity])
  @@index([status])
  @@index([source])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

model IncidentIOC {
  incidentId String
  iocId      String
  linkedById String
  createdAt  DateTime @default(now())
  notes      String?
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ioc        IOC      @relation(fields: [iocId], references: [id], onDelete: Cascade)
  linkedBy   User     @relation("LinkedIncidentIOCs", fields: [linkedById], references: [id])

  @@id([incidentId, iocId])
  @@index([iocId])
  @@index([linkedById])
  @@index([createdAt])
  @@index([incidentId, createdAt])
  @@index([iocId, createdAt])
}

model Alert {
  id             String           @id @default(uuid())
  title          String
  description    String?
  severity       IncidentSeverity
  status         AlertStatus      @default(NEW)
  source         DetectionSource
  sourceEventId  String?
  incidentId     String?
  assignedToId   String?
  detectedAt     DateTime
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignedTo     User?            @relation("AssignedAlerts", fields: [assignedToId], references: [id])
  incident       Incident?        @relation(fields: [incidentId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([source])
  @@index([incidentId])
  @@index([assignedToId])
  @@index([detectedAt])
  @@index([status, severity])
  @@index([status, detectedAt])
}

enum Role {
  VIEWER
  ANALYST
  ADMIN
  SOC_MANAGER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINED
  ERADICATED
  RECOVERED
  CLOSED
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentCategory {
  MALWARE
  PHISHING
  BRUTE_FORCE
  WEB_ATTACK
  INSIDER_THREAT
  RECONNAISSANCE
  DATA_EXFILTRATION
  POLICY_VIOLATION
  OTHER
}

enum DetectionSource {
  MANUAL
  SIEM
  WAZUH
  SPLUNK
  MICROSOFT_DEFENDER
  CROWDSTRIKE
  SURICATA
  AI_ENGINE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_ASSIGNED
  INCIDENT_STATUS_CHANGED
  INCIDENT_CLOSED
  INCIDENT_DELETED
  INCIDENT_VIEWED
  INCIDENTS_VIEWED
  AUDIT_LOGS_VIEWED
}

enum TimelineAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  EVIDENCE_UPLOADED
  REOPENED
  CLOSED
  IOC_LINKED
  IOC_UNLINKED
}

enum IOCType {
  IP
  DOMAIN
  URL
  EMAIL
  SHA256
  SHA1
  MD5
  FILE_NAME
  CVE
  MITRE_TECHNIQUE
}

enum IOCSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IOCStatus {
  ACTIVE
  WHITELISTED
  FALSE_POSITIVE
  EXPIRED
}

enum IOCSource {
  MANUAL
  VIRUSTOTAL
  ABUSEIPDB
  OTX
  MISP
  WAZUH
  SPLUNK
  AI_ENGINE
  OTHER
}
