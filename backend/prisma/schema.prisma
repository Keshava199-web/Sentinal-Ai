generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  ANALYST
  SOC_MANAGER
  ADMIN
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINED
  ERADICATED
  RECOVERED
  CLOSED
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportedIncidents Incident[] @relation("ReportedIncidents")
  assignedIncidents Incident[] @relation("AssignedIncidents")

  auditLogs AuditLog[] @relation("UserAuditLogs")
}

model Incident {
  id          String @id @default(uuid())
  title       String
  description String

  severity IncidentSeverity
  status   IncidentStatus   @default(OPEN)
  category IncidentCategory @default(OTHER)

  detectionSource DetectionSource @default(MANUAL)

  sourceIp      String?
  destinationIp String?
  hostname      String?

  reporterId String
  reporter   User   @relation("ReportedIncidents", fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[] @relation("IncidentAuditLogs")

  @@index([resolvedAt])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([detectionSource])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, severity])
  @@index([status, createdAt])
}

model AuditLog {
  id     String      @id @default(uuid())
  action AuditAction

  userId     String
  incidentId String?

  createdAt DateTime @default(now())

  user     User      @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  incident Incident? @relation("IncidentAuditLogs", fields: [incidentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([incidentId])
}

enum IncidentCategory {
  MALWARE
  PHISHING
  BRUTE_FORCE
  WEB_ATTACK
  INSIDER_THREAT
  RECONNAISSANCE
  DATA_EXFILTRATION
  POLICY_VIOLATION
  OTHER
}

enum DetectionSource {
  MANUAL
  SIEM
  WAZUH
  SPLUNK
  MICROSOFT_DEFENDER
  CROWDSTRIKE
  SURICATA
  AI_ENGINE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT

  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_ASSIGNED
  INCIDENT_STATUS_CHANGED
  INCIDENT_CLOSED
  INCIDENT_DELETED
}
