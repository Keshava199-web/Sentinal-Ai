generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  createdAt          DateTime           @default(now())
  role               Role               @default(VIEWER)
  updatedAt          DateTime           @updatedAt
  auditLogs          AuditLog[]         @relation("UserAuditLogs")
  evidence           IncidentEvidence[]
  iocs               IOC[]              @relation("CreatedIOCs")
  linkedIncidentIOCs IncidentIOC[]      @relation("LinkedIncidentIOCs")

  timelineEntries IncidentTimeline[]

  comments IncidentComment[]

  assignedIncidents Incident[] @relation("AssignedIncidents")
  reportedIncidents Incident[] @relation("ReportedIncidents")
  assignedAlerts    Alert[]    @relation("AssignedAlerts")
}

model Incident {
  id           String   @id @default(uuid())
  title        String
  description  String
  sourceIp     String?
  createdAt    DateTime @default(now())
  assignedToId String?

  timeline IncidentTimeline[]
  comments IncidentComment[]
  evidence IncidentEvidence[]
  iocs     IncidentIOC[]

  category        IncidentCategory @default(OTHER)
  destinationIp   String?
  detectionSource DetectionSource  @default(MANUAL)
  hostname        String?
  reporterId      String
  resolvedAt      DateTime?
  updatedAt       DateTime         @updatedAt
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  auditLogs       AuditLog[]       @relation("IncidentAuditLogs")
  assignedTo      User?            @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  reporter        User             @relation("ReportedIncidents", fields: [reporterId], references: [id])

  alerts Alert[]

  @@index([resolvedAt])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([detectionSource])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, severity])
  @@index([status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  incidentId String?
  createdAt  DateTime    @default(now())
  action     AuditAction
  incident   Incident?   @relation("IncidentAuditLogs", fields: [incidentId], references: [id])
  user       User        @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([incidentId])
}

model IncidentTimeline {
  id          String         @id @default(uuid())
  incidentId  String
  userId      String?
  action      TimelineAction
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([createdAt])
  @@index([action])
  @@index([incidentId, createdAt])
}

model IncidentComment {
  id String @id @default(uuid())

  incidentId String
  userId     String

  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@index([incidentId])
  @@index([userId])
  @@index([createdAt])
  @@index([incidentId, createdAt])
}

model IncidentEvidence {
  id String @id @default(uuid())

  incidentId   String
  uploadedById String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  storagePath  String
  sha256       String
  uploadedAt   DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@index([uploadedById])
  @@index([uploadedAt])
  @@index([sha256])
}

model IOC {
  id String @id @default(uuid())

  type  IOCType
  value String  @db.Text

  description String? @db.Text

  severity IOCSeverity

  confidence Int @default(50)

  firstSeen DateTime?

  lastSeen DateTime?

  status IOCStatus @default(ACTIVE)

  source IOCSource @default(MANUAL)

  createdById String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdBy User @relation("CreatedIOCs", fields: [createdById], references: [id])

  incidents IncidentIOC[]

  deletedAt DateTime?

  @@unique([type, value, source])
  @@index([firstSeen])
  @@index([lastSeen])
  @@index([type])
  @@index([value])
  @@index([type, value])
  @@index([severity])
  @@index([status])
  @@index([source])
  @@index([createdById])
  @@index([createdAt])
  @@index([deletedAt])
}

model IncidentIOC {
  incidentId String

  iocId String

  linkedById String

  createdAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  ioc IOC @relation(fields: [iocId], references: [id], onDelete: Cascade)

  linkedBy User @relation("LinkedIncidentIOCs", fields: [linkedById], references: [id])

  notes String? @db.Text

  @@id([incidentId, iocId])
  @@index([iocId])
  @@index([linkedById])
  @@index([createdAt])
  @@index([incidentId, createdAt])
  @@index([iocId, createdAt])
}

model Alert {
  id String @id @default(uuid())

  title       String
  description String

  severity AlertSeverity
  status   AlertStatus   @default(NEW)
  source   AlertSource

  assignedToId String?
  assignedTo   User?   @relation("AssignedAlerts", fields: [assignedToId], references: [id])

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  rawEvent Json?
  metadata Json?

  detectedAt     DateTime
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([source])
  @@index([assignedToId])
  @@index([incidentId])
  @@index([detectedAt])
}

enum Role {
  VIEWER
  ANALYST
  ADMIN
  SOC_MANAGER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINED
  ERADICATED
  RECOVERED
  CLOSED
}

enum IncidentCategory {
  MALWARE
  PHISHING
  BRUTE_FORCE
  WEB_ATTACK
  INSIDER_THREAT
  RECONNAISSANCE
  DATA_EXFILTRATION
  POLICY_VIOLATION
  OTHER
}

enum DetectionSource {
  MANUAL
  SIEM
  WAZUH
  SPLUNK
  MICROSOFT_DEFENDER
  CROWDSTRIKE
  SURICATA
  AI_ENGINE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_ASSIGNED
  INCIDENT_STATUS_CHANGED
  INCIDENT_CLOSED
  INCIDENT_DELETED
  INCIDENT_VIEWED
  INCIDENTS_VIEWED
  AUDIT_LOGS_VIEWED
}

enum TimelineAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  EVIDENCE_UPLOADED

  IOC_LINKED
  IOC_UNLINKED

  REOPENED
  CLOSED
}

enum IOCType {
  IP
  DOMAIN
  URL
  EMAIL
  SHA256
  SHA1
  MD5
  FILE_NAME
  CVE
  MITRE_TECHNIQUE
}

enum IOCSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IOCStatus {
  ACTIVE
  WHITELISTED
  FALSE_POSITIVE
  EXPIRED
}

enum IOCSource {
  MANUAL
  VIRUSTOTAL
  ABUSEIPDB
  OTX
  MISP
  WAZUH
  SPLUNK
  AI_ENGINE
  OTHER
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  NEW
  TRIAGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum AlertSource {
  SIEM
  EDR
  FIREWALL
  IDS
  IPS
  EMAIL
  THREAT_INTEL
  MANUAL
}
