generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  createdAt         DateTime   @default(now())
  role              Role       @default(VIEWER)
  updatedAt         DateTime   @updatedAt
  auditLogs         AuditLog[] @relation("UserAuditLogs")
  assignedIncidents Incident[] @relation("AssignedIncidents")
  reportedIncidents Incident[] @relation("ReportedIncidents")
}

model Incident {
  id              String           @id @default(uuid())
  title           String
  description     String
  sourceIp        String?
  createdAt       DateTime         @default(now())
  assignedToId    String?
  category        IncidentCategory @default(OTHER)
  destinationIp   String?
  detectionSource DetectionSource  @default(MANUAL)
  hostname        String?
  reporterId      String
  resolvedAt      DateTime?
  updatedAt       DateTime         @updatedAt
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  auditLogs       AuditLog[]       @relation("IncidentAuditLogs")
  assignedTo      User?            @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  reporter        User             @relation("ReportedIncidents", fields: [reporterId], references: [id])

  @@index([resolvedAt])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([detectionSource])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, severity])
  @@index([status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  incidentId String?
  createdAt  DateTime    @default(now())
  action     AuditAction
  incident   Incident?   @relation("IncidentAuditLogs", fields: [incidentId], references: [id])
  user       User        @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([incidentId])
}

enum Role {
  VIEWER
  ANALYST
  ADMIN
  SOC_MANAGER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  CONTAINED
  ERADICATED
  RECOVERED
  CLOSED
}

enum IncidentCategory {
  MALWARE
  PHISHING
  BRUTE_FORCE
  WEB_ATTACK
  INSIDER_THREAT
  RECONNAISSANCE
  DATA_EXFILTRATION
  POLICY_VIOLATION
  OTHER
}

enum DetectionSource {
  MANUAL
  SIEM
  WAZUH
  SPLUNK
  MICROSOFT_DEFENDER
  CROWDSTRIKE
  SURICATA
  AI_ENGINE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_ASSIGNED
  INCIDENT_STATUS_CHANGED
  INCIDENT_CLOSED
  INCIDENT_DELETED
  INCIDENT_VIEWED
  INCIDENTS_VIEWED
  AUDIT_LOGS_VIEWED
}
